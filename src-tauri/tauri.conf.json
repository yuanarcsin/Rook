{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rook",
  "version": "0.1.0",
  "identifier": "com.rook.app",
  "mainBinaryName": "Rook",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rook",
        "create": false,
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 540,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rook",
    "licenseFile": "../LICENSE",
    "shortDescription": "本机脚本的常驻值守",
    "longDescription": "Rook 负责把用户自己的自动化脚本按时拉起、崩溃重启、探测健康并留存日志。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
